<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="2dp" android:insetRight="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#575AD3" />
                <corners android:radius="2dp" />
                <size android:width="16dp" android:height="4dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="8dp" android:insetRight="8dp">
            <shape android:shape="rectangle">
                <solid android:color="#66FFFFFF" />
                <corners android:radius="2dp" />
                <size android:width="4dp" android:height="4dp" />
            </shape>
        </inset>
    </item>
</selector>