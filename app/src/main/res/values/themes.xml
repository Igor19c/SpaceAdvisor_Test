<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SpaceAdvisor" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="Theme.SpaceAdvisor" parent="Base.Theme.SpaceAdvisor" />

    <!-- FullScreen Theme for AuthUI -->
    <style name="Theme.Auth.FullScreen" parent="FirebaseUI">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Hide navigation bar on newer versions -->
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <!-- Style for the Onboarding Dialog -->
    <style name="CustomAlertDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:background">@color/layout_background_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.MediumComponent</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>
</resources>