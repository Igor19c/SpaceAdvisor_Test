<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="250dp"
    android:layout_height="300dp"
    android:layout_margin="10dp"
    android:backgroundTint="@color/layout_background_primary"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="10dp">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/trend_dest_image_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_home_earth" />

        <View
            android:id="@+id/trend_dest_card_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/layout_background_transparent_black_20" />

        <LinearLayout
            android:id="@+id/dest_rating_chip_carousel_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/custom_text_gray_background"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_rating_star_filled"
                app:tint="@color/icon_primary" />

            <TextView
                android:id="@+id/trend_dest_rating_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:text="4.5"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/trend_dest_details_container_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/layout_background_transparent_black_60"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp">


            <TextView
                android:id="@+id/trend_dest_title_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Title"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/trend_dest_subtitle_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Subtitle"
                android:textColor="@color/text_quaternary_light"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_explore_trend_dest_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explore"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                app:backgroundTint="@color/btn_fill_primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd"
                app:iconSize="16sp"
                app:iconTint="@color/icon_secondary" />
        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>