<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@color/colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">


    <RelativeLayout
        android:id="@+id/post_header_container"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/user_profile_image_post_item"
            style="@style/ShapeAppearance.Material3.Corner.Full"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/pic_profile" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/user_profile_image_post_item"
            android:orientation="vertical">

            <TextView
                android:id="@+id/user_name_post_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/trip_title_post_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trip Title"
                android:textColor="@color/textQuaternary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="5dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rating_star_01_post_item"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="-4dp"
                android:src="@drawable/ic_rating_star_filled" />

            <ImageView
                android:id="@+id/rating_star_02_post_item"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="-4dp"
                android:src="@drawable/ic_rating_star_filled" />

            <ImageView
                android:id="@+id/rating_star_03_post_item"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="-4dp"
                android:src="@drawable/ic_rating_star_filled" />

            <ImageView
                android:id="@+id/rating_star_04_post_item"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="-4dp"
                android:src="@drawable/ic_rating_star_filled" />

            <ImageView
                android:id="@+id/rating_star_05_post_item"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_rating_star_filled" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_btn_post_item"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="-8dp"
            app:icon="@drawable/ic_dots"
            app:iconSize="30dp"
            app:iconTint="@color/white" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/post_image_container"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/post_header_container">

        <ImageView
            android:id="@+id/image_post_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBackground"
            android:clickable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_home_earth" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/post_image_container">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/like_btn_post_item"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_star_outlined"
                android:tint="@color/space_purple" />

            <TextView
                android:id="@+id/like_counter_post_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="47"
                android:textColor="@color/textPrimary"
                android:textSize="18sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/description_post_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="34dp"
            android:text="The sunrise on Mars is absolutely breathtaking! Blue hues dancing across the red landscape. A must-visit!"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/post_settings_btn_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="45dp"
        android:visibility="gone"
        app:cardBackgroundColor="#60000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="#20E8EAF6"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_btn_post_item"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent"
                android:text="Delete"
                android:textColor="@color/red_muted"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_btn_post_item"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent"
                android:text="Edit"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>