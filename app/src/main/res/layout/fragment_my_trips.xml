<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Normal State: Trip List -->
    <RelativeLayout
        android:id="@+id/trips_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <RelativeLayout
            android:id="@+id/create_new_trip_btn_container_my_trips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create_trip_fab"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:text="Create Trip"
                android:textColor="@color/on_primary"
                android:textSize="16sp"
                app:backgroundTint="?attr/customColorPrimary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_plus"
                app:iconPadding="5dp"
                app:iconSize="15dp"
                app:iconTint="@color/on_primary" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/my_trips_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/create_new_trip_btn_container_my_trips"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/draft_trips_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_trip" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="@color/background" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>
    </RelativeLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/empty_state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:alpha="0.5"
            android:src="@drawable/ic_explore"
            app:tint="@color/icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Ready for your next adventure?"
            android:textColor="@color/title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Start planning your dream trip across the galaxy today!"
            android:textColor="@color/body"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_create_trip_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            android:text="Plan My First Trip"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            app:backgroundTint="?attr/customColorPrimary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_plus"
            app:iconTint="@color/on_primary" />

    </LinearLayout>

</RelativeLayout>
