<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp">

        <TextView
            android:id="@+id/dest_count_saved_fragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="11 Saved"
            android:textColor="@color/body"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/unsave_all_btn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="-12dp"
            android:text="Unsave all"
            android:textColor="@color/secondary"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:strokeWidth="0dp" />

    </RelativeLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/empty_state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:alpha="0.4"
            android:src="@drawable/ic_rocket"
            app:tint="@color/icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Explore new destinations 🚀"
            android:textColor="@color/title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="And save them here"
            android:textColor="@color/body"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_create_trip_btn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_gradient"
            android:elevation="4dp"
            android:paddingHorizontal="24dp"
            android:shadowColor="@color/transparent_black_60"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:text="Explore Destinations"
            android:textColor="@color/on_primary"
            android:textSize="14sp"
            app:backgroundTint="@null"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_explore"
            app:iconPadding="12dp"
            app:iconSize="18dp"
            app:iconTint="@color/on_primary" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/my_destinations_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_saved_destination" />

</androidx.appcompat.widget.LinearLayoutCompat>